{
  "name": "applypilot-rewrite",
  "main": "worker/rewrite.ts",
  "compatibility_date": "2026-09-05",
  "vars": {
    "RESUME_AI_ENDPOINT": "https://api.deepseek.com/chat/completions",
    "RESUME_AI_MODEL": "[your-json-capable-model]"
  },
  "ratelimits": [
    {"name":"RESUME_REWRITE_LIMITER","namespace_id":"1001","simple":{"limit":5,"period":60}}
  ]
}
